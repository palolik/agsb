# Apache / LiteSpeed config for the production host (vercel.json and
# _redirects are only read by Vercel / Netlify).

Options -MultiViews -Indexes
# home.html is the prerendered home page (scripts/prerender.mjs); index.html
# stays the plain SPA shell used as the fallback for every other route.
DirectoryIndex home.html index.html
# /districts is both a page (districts.html) and a folder of detail pages;
# don't let the server 301 it to /districts/ before the rules below run.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical origin: https, no www.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://amighurisharabangladesh.com%{REQUEST_URI} [R=301,L,NE]

  # Drop trailing slashes (except the root) so each page has one URL.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Prerendered home page.
  RewriteCond %{DOCUMENT_ROOT}/home.html -f
  RewriteRule ^$ /home.html [L]

  # Prerendered pages from scripts/prerender.mjs: /blog/x -> /blog/x.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]

  # Everything else that isn't a real file goes to the SPA.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
