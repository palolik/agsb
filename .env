# Backend API base URL (required for production builds)
VITE_API_BASE_URL=https://backpack.amighurisharabangladesh.com/api/

# Public contact details and social links (src/config/site.js).
# Leave a value empty to hide that link or line on the site.
# Phone as it should be displayed, e.g. +880 1712-345678
VITE_CONTACT_PHONE=
# WhatsApp number, digits only with country code, e.g. 8801712345678
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
# Full profile URLs, e.g. https://www.facebook.com/yourpage
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_YOUTUBE=

# Public URL of this site, no trailing slash (used for canonical/Open Graph
# URLs and to generate dist/sitemap.xml + robots.txt at build time).
VITE_SITE_URL=https://example.com
