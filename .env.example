# Backend API base URL (required for production builds)
VITE_API_BASE_URL=http://localhost:5001/api

# Public contact details and social links (src/config/site.js).
# Leave a value empty to hide that link or line on the site.
# Phone as it should be displayed, e.g. +880 1712-345678
VITE_CONTACT_PHONE=
# WhatsApp number, digits only with country code, e.g. 8801712345678
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
# Full profile URLs, e.g. https://www.facebook.com/yourpage
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_YOUTUBE=

# Public URL of this site, no trailing slash (used for canonical/Open Graph
# URLs and to generate dist/sitemap.xml + robots.txt at build time).
VITE_SITE_URL=

# Firebase web app config for push notifications (src/lib/firebase.js).
# These are public client values, not secrets. Push is turned off when any
# of the required values or the VAPID key is missing.
VITE_FIREBASE_API_KEY=AIzaSyAlihp9r0ZFRuVjvwqaXhJyTaoMRQQ_ofE
VITE_FIREBASE_AUTH_DOMAIN=agsb-d8b6f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agsb-d8b6f
VITE_FIREBASE_STORAGE_BUCKET=agsb-d8b6f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=889733119198
VITE_FIREBASE_APP_ID=1:889733119198:web:8bda9cb5981dd1067dd64f
# Not used by the site (no Analytics); kept for completeness.
VITE_FIREBASE_MEASUREMENT_ID=G-YHET2SVRQF
# Web push certificate (public key). Firebase console > Project settings >
# Cloud Messaging > Web Push certificates > Generate key pair.
VITE_FIREBASE_VAPID_KEY=
